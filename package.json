{
  "name": "stock-project",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=24 <25", "npm": ">=11 <12" },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "test:safety": "node --test scripts/test_*.mjs && node --experimental-strip-types scripts/test_news_curation.mts && python3 scripts/test_model_safety.py && python3 scripts/test_data_quality.py && python3 -m unittest discover -s backend -p 'test_*.py'",
    "typecheck": "tsc --noEmit --project frontend/tsconfig.json",
    "lint:baseline": "node scripts/check_lint_baseline.mjs",
    "audit:migrations": "node scripts/audit_migrations.mjs",
    "test:trading": "node --test scripts/test_trading.mjs",
    "test:trading-db": "node --test scripts/test_trading_db.mjs",
    "backtest:trading": "node scripts/replay_trading.mjs",
    "build": "cd frontend && npm run build",
    "start": "cd frontend && npm run start",
    "dev": "cd frontend && npm run dev"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "supabase": "2.121.0"
  },
  "workspaces": [
    "frontend"
  ]
}
