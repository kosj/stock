# ============================================================
# Railway 배포 시 설정해야 하는 환경변수
# Railway Dashboard → Service → Variables
# ============================================================

# 데이터베이스
# Railway PostgreSQL 플러그인 추가 후 자동 주입되는 DATABASE_URL 사용
# (Railway가 자동으로 postgresql+asyncpg:// 형식으로 주입)
DATABASE_URL=postgresql+asyncpg://user:password@host:port/db
# 로컬 개발용:
# DATABASE_URL=sqlite+aiosqlite:///./stock.db

# CORS — Vercel 프론트엔드 rewrites 경유 시 * 허용 가능
CORS_ORIGINS=*

# KIS (한국투자증권) API — 선택사항 (없으면 Mock 데이터 사용)
KIS_MODE=mock
KIS_APPKEY=
KIS_APPSECRET=
KIS_ACCOUNT=
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# Anthropic (Claude API) — 선택사항
ANTHROPIC_API_KEY=

# FRED API (거시경제 데이터) — 선택사항
FRED_API_KEY=

# 웹 푸시 알림 (VAPID) — 선택사항
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

# 앱 설정
APP_ENV=production
SECRET_KEY=change-this-to-a-secure-random-string
