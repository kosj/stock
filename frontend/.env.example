# ============================================================
# Vercel 배포 시 설정해야 하는 환경변수
# Vercel Dashboard → Project → Settings → Environment Variables
# ============================================================

# Supabase (필수) — https://supabase.com → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
# Server-only; required for protected data/RPCs. Never use NEXT_PUBLIC_ for this key.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only broker credential encryption and cron authentication (see docs/credential-security.md).
BROKER_ENCRYPTION_KEY=
CRON_SECRET=
# Simulation risk ceilings; fractions, not optimized return targets.
MOCK_MAX_POSITION_WEIGHT=0.25
MOCK_MAX_SECTOR_WEIGHT=0.50

# Anthropic Claude API (선택 — 없으면 규칙 기반 분석 사용)
ANTHROPIC_API_KEY=sk-ant-...

# FRED API (선택 — 없으면 금리/CPI 데이터 비활성화)
# https://fred.stlouisfed.org/docs/api/api_key.html (무료)
FRED_API_KEY=
